# Environment configuration for the FightFind API.
# Copy to .env and fill in real values. Never commit real secrets.

NODE_ENV=development
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (docker compose provides this default)
DATABASE_URL=postgres://fightfind:fightfind@localhost:5432/fightfind
# Max pooled connections per API instance. Lower this (e.g. 5) when using a
# managed pooler such as Supabase with multiple replicas.
DATABASE_POOL_MAX=10
#
# Supabase (production): use the Session pooler connection string and require TLS.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# For strict certificate verification, mount Supabase's prod-ca-2021.crt and use:
#   ...?sslmode=verify-full&sslrootcert=/path/to/prod-ca-2021.crt
# If the connection fails with SELF_SIGNED_CERT_IN_CHAIN (e.g. a TLS-inspecting
# proxy or an untrusted chain), use ...?sslmode=no-verify instead.
# Run migrations against the session pooler (never the transaction pooler) and
# disable the Supabase Data API so the public schema is not exposed.

# Auth — generate long random strings in production
JWT_SECRET=dev-jwt-secret-change-me-0000000000000000
SESSION_SECRET=dev-session-secret-change-me-00000000
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# OTP — only accepted when NODE_ENV is development/test
DEV_OTP=123456
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5

# OTP delivery providers (optional in dev; required in production for each channel)
# SMS via MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
# Email via Resend
RESEND_API_KEY=
EMAIL_FROM="FightFind <no-reply@fightfind.in>"

# Public base URL of the API (used for upload URLs and webhook docs)
API_PUBLIC_URL=http://localhost:4001
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3001,http://localhost:8081,http://localhost:19006

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_FIGHTER_PLAN_ID=
RAZORPAY_GYM_PLAN_ID=
RAZORPAY_ACCOUNT_NUMBER=
# test | live | mock
PAYMENT_MODE=test
# Development-only simulator route guard (never enable in production)
PAYMENT_SIMULATOR_ENABLED=false
# Development: fall back to a one-time monthly order when Razorpay Subscriptions
# are unavailable (e.g. product not enabled on the account).
SUBSCRIPTIONS_FALLBACK_TO_ORDERS=true
# Development: skip Razorpay Route transfers (recorded as processing instead).
SKIP_ROUTE_TRANSFERS=false

# Pricing overrides in paise (defaults: 19900 / 99900 / 39900)
FIGHTER_PREMIUM_MONTHLY_PAISE=19900
GYM_LISTING_FEE_PAISE=99900
GYM_PLATFORM_MONTHLY_PAISE=39900
# Percentage of gym membership payments kept by FightFind (0 = gym receives 100%)
PLATFORM_COMMISSION_PERCENT=0
# Auto-activate memberships on payment instead of requiring gym-owner approval
GYM_MEMBERSHIP_AUTO_APPROVE=false
# Days a gym listing stays live after a failed platform subscription before suspension
GYM_SUBSCRIPTION_GRACE_DAYS=7

# Expo push notifications (optional)
EXPO_ACCESS_TOKEN=

# Local storage for uploads (dev). Swap for S3-compatible storage provider later.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# S3-compatible storage (required when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Analytics sink: log | posthog | none
ANALYTICS_SINK=log
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Seed data
SEED_DEMO_PASSWORD=fightfind-demo
