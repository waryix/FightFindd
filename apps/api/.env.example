PORT=4000

# Brevo transactional email (https://app.brevo.com/settings/keys/api)
# The sender email must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FightFind

# OTP policy
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Force the dev bypass (accept DEV_OTP) even when BREVO_API_KEY is set.
# OTP_DEV_BYPASS=true
