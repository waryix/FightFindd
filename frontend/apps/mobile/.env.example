# Public API base URL. For a physical device use your machine's LAN IP,
# e.g. EXPO_PUBLIC_API_URL=http://192.168.1.20:4001
EXPO_PUBLIC_API_URL=http://localhost:4001

# Optional: Expo project id for push notifications
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional: analytics forwarding on the client (server-side sink is preferred)
EXPO_PUBLIC_ANALYTICS_ENABLED=true
